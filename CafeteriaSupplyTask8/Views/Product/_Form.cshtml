@model ProductViewModel
<div asp-validation-summary="All" class="validation" role="alert"></div>
<input asp-for="Id" type="hidden" /><input asp-for="RowVersion" type="hidden" />
<label asp-for="Name"></label><input asp-for="Name" maxlength="100" required />
<label asp-for="Description"></label><textarea asp-for="Description" maxlength="500" rows="3"></textarea>
<div class="form-grid"><div><label asp-for="Price"></label><input asp-for="Price" type="number" min="0.01" max="1000000" step="0.01" required /></div>
<div><label asp-for="Quantity"></label><input asp-for="Quantity" type="number" min="0" max="1000000" step="1" required /></div></div>
<div class="actions"><button class="button" type="submit">Save product</button><a class="button secondary" asp-action="Index">Cancel</a></div>
