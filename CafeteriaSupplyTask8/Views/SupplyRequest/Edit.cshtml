@model RequestFormViewModel
@{ ViewData["Title"] = "Edit request"; }
<div class="page-heading"><h1>Edit request #@Model.Id</h1><span class="badge Pending">Pending</span></div>
<section class="card"><form asp-action="Edit" asp-route-id="@Model.Id" method="post"><partial name="_Form" model="Model" /></form></section>
@section Scripts { <script src="~/js/request.js" asp-append-version="true"></script> }
