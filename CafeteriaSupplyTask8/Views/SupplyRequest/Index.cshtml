@model List<SupplyRequest>
@{ ViewData["Title"] = "Supply requests"; var manager = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.SuperAdmin); }
<div class="page-heading"><div><h1>@(manager ? "All supply requests" : "My supply requests")</h1></div><a class="button" asp-action="Create">New request</a></div>
@if (Model.Count == 0) { <div class="card empty"><h2>No requests yet</h2></div> }
else
{
<div class="card table-wrap"><table><thead><tr><th>Request</th><th>Date (UTC)</th>@if (manager) { <th>Requested by</th> }<th>Total</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var r in Model)
{
<tr><td><strong>#@r.Id</strong></td><td>@r.RequestDate.ToString("yyyy-MM-dd HH:mm")</td>@if (manager) { <td>@r.User.FullName<small>@r.User.Email</small></td> }<td>@r.TotalPrice.ToString("N2")</td><td><span class="badge @r.Status">@r.Status</span></td><td><a asp-action="Details" asp-route-id="@r.Id">View request</a></td></tr>
}
</tbody></table></div>
}
