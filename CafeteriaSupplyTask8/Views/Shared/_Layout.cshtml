<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · University Cafeteria</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="topbar">
    <a class="brand" asp-controller="Home" asp-action="Index">University Cafeteria</a>
    <nav aria-label="Main navigation">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-controller="Product" asp-action="Index">Products</a>
        <a asp-controller="SupplyRequest" asp-action="Index">Requests</a>
        @if (User.IsInRole(AppRoles.SuperAdmin)) { <a asp-controller="Admin" asp-action="Index">Users</a> }
        <form asp-controller="Account" asp-action="Logout" method="post"><button class="button subtle" type="submit">Log out</button></form>
    }
    else
    {
        <a asp-controller="Account" asp-action="Login">Log in</a>
        <a class="button" asp-controller="Account" asp-action="Register">Create account</a>
    }
    </nav>
</header>
<main class="container">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="session"><span>@User.Identity.Name</span><span class="badge">@(User.IsInRole(AppRoles.SuperAdmin) ? "SuperAdmin" : User.IsInRole(AppRoles.Admin) ? "Admin" : "User")</span></div>
    }
    @if (TempData["Success"] is string success) { <div class="notice success" role="status">@success</div> }
    @if (TempData["Error"] is string error) { <div class="notice error" role="alert">@error</div> }
    @RenderBody()
</main>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
